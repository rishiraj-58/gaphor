<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <!-- Template Editor Dialog -->
  <object class="GtkWindow" id="template-editor-window">
    <property name="title" translatable="yes">Template Editor</property>
    <property name="default-width">700</property>
    <property name="default-height">600</property>
    <property name="modal">1</property>
    <child type="titlebar">
      <object class="GtkHeaderBar">
        <child type="start">
          <object class="GtkButton" id="cancel-button">
            <property name="label" translatable="yes">Cancel</property>
          </object>
        </child>
        <child type="end">
          <object class="GtkButton" id="save-button">
            <property name="label" translatable="yes">Save</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkNotebook" id="editor-notebook">
            <property name="vexpand">1</property>

            <!-- General Page -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="GtkViewport">
                        <child>
                          <object class="GtkGrid" id="general-grid">
                            <property name="row-spacing">12</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-top">18</property>
                            <property name="margin-bottom">18</property>

                            <!-- Name -->
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Name:</property>
                                <property name="halign">end</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="name-entry">
                                <property name="hexpand">1</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">0</property>
                                </layout>
                              </object>
                            </child>

                            <!-- Description -->
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Description:</property>
                                <property name="halign">end</property>
                                <property name="valign">start</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkScrolledWindow">
                                <property name="min-content-height">80</property>
                                <property name="hexpand">1</property>
                                <child>
                                  <object class="GtkTextView" id="description-view">
                                    <property name="wrap-mode">word</property>
                                  </object>
                                </child>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">1</property>
                                </layout>
                              </object>
                            </child>

                            <!-- Category -->
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Category:</property>
                                <property name="halign">end</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="category-dropdown">
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">2</property>
                                </layout>
                              </object>
                            </child>

                            <!-- Modeling Language -->
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Modeling Language:</property>
                                <property name="halign">end</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkDropDown" id="language-dropdown">
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">3</property>
                                </layout>
                              </object>
                            </child>

                            <!-- Tags -->
                            <child>
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Tags:</property>
                                <property name="halign">end</property>
                                <layout>
                                  <property name="column">0</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="tags-entry">
                                <property name="placeholder-text" translatable="yes">Comma-separated tags</property>
                                <layout>
                                  <property name="column">1</property>
                                  <property name="row">4</property>
                                </layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">General</property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Content Page -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="content-page">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Paste Gaphor XML content here. Use ${parameter_name} for placeholders.</property>
                        <property name="halign">start</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">1</property>
                        <property name="hscrollbar-policy">automatic</property>
                        <property name="vscrollbar-policy">automatic</property>
                        <child>
                          <object class="GtkTextView" id="content-view">
                            <property name="monospace">1</property>
                            <property name="wrap-mode">none</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="extract-params-button">
                        <property name="label" translatable="yes">Extract Parameters</property>
                        <property name="halign">start</property>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Content</property>
                  </object>
                </property>
              </object>
            </child>

            <!-- Parameters Page -->
            <child>
              <object class="GtkNotebookPage">
                <property name="child">
                  <object class="GtkBox" id="parameters-page">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="add-param-button">
                            <property name="label" translatable="yes">Add Parameter</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">1</property>
                        <property name="hscrollbar-policy">never</property>
                        <child>
                          <object class="GtkListBox" id="parameters-list">
                            <property name="selection-mode">none</property>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="tab">
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Parameters</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <!-- Validation Bar -->
        <child>
          <object class="GtkInfoBar" id="validation-bar">
            <property name="revealed">0</property>
            <property name="message-type">error</property>
            <child>
              <object class="GtkLabel" id="validation-label">
                <property name="wrap">1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>

  <!-- Parameter Row Template -->
  <object class="GtkListBoxRow" id="parameter-row-template">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">horizontal</property>
        <property name="spacing">12</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <child>
          <object class="GtkEntry" id="param-name-entry">
            <property name="placeholder-text" translatable="yes">Name</property>
            <property name="width-chars">15</property>
          </object>
        </child>
        <child>
          <object class="GtkDropDown" id="param-type-dropdown"/>
        </child>
        <child>
          <object class="GtkEntry" id="param-default-entry">
            <property name="placeholder-text" translatable="yes">Default</property>
            <property name="width-chars">12</property>
          </object>
        </child>
        <child>
          <object class="GtkCheckButton" id="param-required-check">
            <property name="label" translatable="yes">Required</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="param-remove-button">
            <property name="icon-name">list-remove-symbolic</property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
