<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>

  <template class="PresentationWindow" parent="AdwWindow">
    <property name="title" translatable="yes">Presentation</property>
    <property name="default-width">1024</property>
    <property name="default-height">768</property>

    <child>
      <object class="GtkBox" id="main-box">
        <property name="orientation">vertical</property>

        <child>
          <object class="GtkOverlay" id="main-overlay">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>

            <!-- Main view container -->
            <child>
              <object class="GtkBox" id="view-container">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
              </object>
            </child>

            <!-- Drawing overlay -->
            <child type="overlay">
              <object class="GtkDrawingArea" id="drawing-overlay">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
              </object>
            </child>

            <!-- Hotspot overlay -->
            <child type="overlay">
              <object class="GtkDrawingArea" id="hotspot-overlay">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
              </object>
            </child>

            <!-- Laser pointer overlay -->
            <child type="overlay">
              <object class="GtkDrawingArea" id="laser-overlay">
                <property name="hexpand">true</property>
                <property name="vexpand">true</property>
              </object>
            </child>

            <!-- Bottom controls -->
            <child type="overlay">
              <object class="GtkRevealer" id="controls-revealer">
                <property name="transition-type">slide-up</property>
                <property name="valign">end</property>
                <property name="reveal-child">true</property>

                <child>
                  <object class="GtkBox" id="controls-box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="halign">center</property>
                    <property name="margin-bottom">20</property>
                    <style>
                      <class name="toolbar"/>
                      <class name="osd"/>
                    </style>

                    <!-- Previous button -->
                    <child>
                      <object class="GtkButton" id="prev-btn">
                        <property name="icon-name">go-previous-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Previous slide (Left/Page Up)</property>
                      </object>
                    </child>

                    <!-- Slide indicator -->
                    <child>
                      <object class="GtkLabel" id="slide-indicator">
                        <property name="label">0 / 0</property>
                        <property name="width-chars">10</property>
                      </object>
                    </child>

                    <!-- Next button -->
                    <child>
                      <object class="GtkButton" id="next-btn">
                        <property name="icon-name">go-next-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Next slide (Right/Page Down/Space)</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">vertical</property>
                      </object>
                    </child>

                    <!-- Drawing toggle -->
                    <child>
                      <object class="GtkToggleButton" id="drawing-btn">
                        <property name="icon-name">document-edit-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Drawing tools (D)</property>
                      </object>
                    </child>

                    <!-- Laser pointer toggle -->
                    <child>
                      <object class="GtkToggleButton" id="laser-btn">
                        <property name="icon-name">starred-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Laser pointer (L)</property>
                      </object>
                    </child>

                    <!-- Clear drawings -->
                    <child>
                      <object class="GtkButton" id="clear-btn">
                        <property name="icon-name">edit-clear-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Clear drawings (C)</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">vertical</property>
                      </object>
                    </child>

                    <!-- Hotspots toggle -->
                    <child>
                      <object class="GtkToggleButton" id="hotspot-btn">
                        <property name="icon-name">find-location-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Show hotspots (H)</property>
                      </object>
                    </child>

                    <!-- Notes button -->
                    <child>
                      <object class="GtkButton" id="notes-btn">
                        <property name="icon-name">accessories-text-editor-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Presenter notes (N)</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">vertical</property>
                      </object>
                    </child>

                    <!-- Fullscreen button -->
                    <child>
                      <object class="GtkButton" id="fullscreen-btn">
                        <property name="icon-name">view-fullscreen-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Toggle fullscreen (F/F11)</property>
                      </object>
                    </child>

                    <!-- Exit button -->
                    <child>
                      <object class="GtkButton" id="exit-btn">
                        <property name="icon-name">window-close-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Exit presentation (Escape)</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <!-- Drawing tools toolbar -->
            <child type="overlay">
              <object class="GtkRevealer" id="drawing-tools-revealer">
                <property name="transition-type">slide-down</property>
                <property name="valign">start</property>
                <property name="halign">center</property>
                <property name="margin-top">10</property>

                <child>
                  <object class="GtkBox" id="drawing-tools-box">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">3</property>
                    <style>
                      <class name="toolbar"/>
                      <class name="osd"/>
                    </style>

                    <!-- Pen tool -->
                    <child>
                      <object class="GtkToggleButton" id="tool-pen">
                        <property name="icon-name">edit-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Pen</property>
                        <property name="active">true</property>
                      </object>
                    </child>

                    <!-- Highlighter tool -->
                    <child>
                      <object class="GtkToggleButton" id="tool-highlighter">
                        <property name="icon-name">format-text-highlight-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Highlighter</property>
                        <property name="group">tool-pen</property>
                      </object>
                    </child>

                    <!-- Arrow tool -->
                    <child>
                      <object class="GtkToggleButton" id="tool-arrow">
                        <property name="icon-name">go-next-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Arrow</property>
                        <property name="group">tool-pen</property>
                      </object>
                    </child>

                    <!-- Rectangle tool -->
                    <child>
                      <object class="GtkToggleButton" id="tool-rectangle">
                        <property name="icon-name">view-fullscreen-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Rectangle</property>
                        <property name="group">tool-pen</property>
                      </object>
                    </child>

                    <!-- Ellipse tool -->
                    <child>
                      <object class="GtkToggleButton" id="tool-ellipse">
                        <property name="icon-name">media-record-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Ellipse</property>
                        <property name="group">tool-pen</property>
                      </object>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">vertical</property>
                      </object>
                    </child>

                    <!-- Color buttons -->
                    <child>
                      <object class="GtkToggleButton" id="color-red">
                        <property name="tooltip-text" translatable="yes">Red</property>
                        <property name="active">true</property>
                        <style>
                          <class name="color-red"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkToggleButton" id="color-blue">
                        <property name="tooltip-text" translatable="yes">Blue</property>
                        <property name="group">color-red</property>
                        <style>
                          <class name="color-blue"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkToggleButton" id="color-green">
                        <property name="tooltip-text" translatable="yes">Green</property>
                        <property name="group">color-red</property>
                        <style>
                          <class name="color-green"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkToggleButton" id="color-yellow">
                        <property name="tooltip-text" translatable="yes">Yellow</property>
                        <property name="group">color-red</property>
                        <style>
                          <class name="color-yellow"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkToggleButton" id="color-black">
                        <property name="tooltip-text" translatable="yes">Black</property>
                        <property name="group">color-red</property>
                        <style>
                          <class name="color-black"/>
                        </style>
                      </object>
                    </child>

                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">vertical</property>
                      </object>
                    </child>

                    <!-- Undo button -->
                    <child>
                      <object class="GtkButton" id="undo-btn">
                        <property name="icon-name">edit-undo-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Undo (Ctrl+Z)</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
